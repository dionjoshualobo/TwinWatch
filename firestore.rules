rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupDoc(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data;
    }

    function isMember(groupId) {
      return signedIn() && groupDoc(groupId).memberUids.hasAny([request.auth.uid]);
    }

    function isOwner(groupId) {
      return signedIn() && groupDoc(groupId).ownerUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /groups/{groupId} {
      allow read: if isMember(groupId);
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if isMember(groupId);
      allow delete: if isOwner(groupId);

      match /members/{memberUid} {
        allow read: if isMember(groupId);
        allow create: if signedIn() && request.auth.uid == memberUid;
        allow delete: if signedIn() && (request.auth.uid == memberUid || isOwner(groupId));
      }

      match /shows/{showId} {
        allow read: if isMember(groupId);
        allow create, delete: if isMember(groupId);
        allow update: if false;
      }

      match /watched/{memberUid}/episodes/{episodeId} {
        allow read: if isMember(groupId);
        allow write: if signedIn() && request.auth.uid == memberUid;
      }

      match /notes/{noteId} {
        allow read: if isMember(groupId) && (resource.data.isPublic == true || resource.data.uid == request.auth.uid);
        allow create: if isMember(groupId) && request.auth.uid == request.resource.data.uid;
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /events/{eventId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && request.auth.uid == request.resource.data.uid;
        allow update, delete: if false;
      }
    }
  }
}
